# Server-only keys. Never prefix with VITE_, or they reach the browser.
# Copy the lines you need into .env.local (git-ignored) for `npm run dev`,
# and into the Vercel project settings for a deployment.

# Companies House public data API (company search and profile).
COMPANIES_HOUSE_API_KEY=

# Certified identity provider (Didit). API key from the provider console,
# Settings > API keys. It needs permission to read sessions.
DIDIT_API_KEY=
# Comma-separated session IDs shown in the ACSP "Identity checks" page.
# Only these sessions can be read through /api/provider/sessions.
DIDIT_SESSION_IDS=

# Password that unlocks the live sessions. Without it, live data stays locked.
PROVIDER_PASSWORD=
